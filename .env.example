# ==============================================================================
# Localized AI Video Ad Pipeline — Environment Configuration Reference
# ==============================================================================
# Security Classification:
#   [SERVER-ONLY]   Must NEVER be exposed to browser bundles or NEXT_PUBLIC_*.
#   [FRONTEND-SAFE] Public browser configuration safe to expose via Next.js.
#
# Never commit a real .env file to version control. Copy this file to `.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime Environment & Worker Mode [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Valid values: development | test | staging | production
# In `production`, startup aborts if mocks, SQLite, wildcard CORS, or weak keys exist.
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Database Connection & RLS Storage [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Development default falls back to sqlite:///./local_dev.db when unset.
# Production MUST configure PostgreSQL (e.g., Supabase Postgres / RDS + PgBouncer).
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Optional Supabase URL & Service Role key (used by SSR helpers / admin sync)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ_REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# ------------------------------------------------------------------------------
# 3. Authentication, JWT Sessions & Signed Media URLs [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Minimum 32 random bytes in production (e.g., `openssl rand -hex 32`).
AUTH_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_HEX_SECRET
# Optional: set to verify Supabase-issued JWTs seamlessly alongside local JWTs
SUPABASE_JWT_SECRET=
# Separate HMAC secret for time-limited video/asset download links
SIGNED_URL_SECRET=REPLACE_WITH_DIFFERENT_32_CHARS_RANDOM_HEX_SECRET
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_SECONDS=900

# ------------------------------------------------------------------------------
# 4. Internal Service & Admin Authorization [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Mandatory in production to authenticate Studio BFF -> FastAPI Worker calls.
WORKER_API_KEY=REPLACE_WITH_STRONG_INTERNAL_WORKER_KEY
# Optional explicit operator secret for manual emergency credit adjustments
ADMIN_ADJUST_SECRET=
# FastAPI base URL reachable by Next.js server routes
WORKER_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 5. CORS & Request Security Limits [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Comma-separated explicit origins. Wildcard `*` is forbidden in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_BODY_BYTES=15728640
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 6. Private Object & Render Storage [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Workspace-isolated root directory (never mount unauthenticated under /static)
STORAGE_ROOT=./storage
SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_IMAGE_BYTES=10485760

# ------------------------------------------------------------------------------
# 7. Celery & Redis Job Queue [SERVER-ONLY]
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=true

# ------------------------------------------------------------------------------
# 8. Stripe Billing & Webhooks [SERVER-ONLY]
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET
STRIPE_CURRENCY=usd
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/?checkout=cancelled
# Authoritative server-side Stripe Price IDs mapped per pack_id
STRIPE_PRICE_STARTER_10=price_REPLACE_STARTER_10
STRIPE_PRICE_GROWTH_50=price_REPLACE_GROWTH_50
STRIPE_PRICE_SCALE_200=price_REPLACE_SCALE_200

# ------------------------------------------------------------------------------
# 9. Promotional & Dev Credit Controls [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Initial signup promo credits granted strictly by server policy (0 disables free credits)
INITIAL_PROMO_CREDITS=0
# Local development convenience ONLY; server rejects with 403 whenever APP_ENV=production
ENABLE_DEV_TOPUP=false

# ------------------------------------------------------------------------------
# 10. Google Cloud & Vertex AI Veo 3.1 [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Set MOCK_VERTEX_VEO=false for real Vertex AI rendering (forbidden to enable mocks in prod)
MOCK_VERTEX_VEO=false
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
VERTEX_VEO_MODEL=veo-3.1-generate-001
GCS_BUCKET=gs://your-private-video-renders-bucket
# Service account JSON file path or short-lived OAuth bearer token (prefer ADC / IAM)
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 11. Google Cloud Text-to-Speech & Script Localization [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Set MOCK_TTS=false to require real Cloud TTS synthesis (no sine oscillator fallback)
MOCK_TTS=false
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 12. Rendering & Media Binaries [SERVER-ONLY]
# ------------------------------------------------------------------------------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Minimum output video duration check before finalizing credit deduction
MIN_RENDER_DURATION_SECONDS=1.5

# ------------------------------------------------------------------------------
# 13. SSRF & Storefront Scraping Controls [SERVER-ONLY]
# ------------------------------------------------------------------------------
SCRAPE_TIMEOUT_SECONDS=10
SCRAPE_MAX_REDIRECTS=3

# ------------------------------------------------------------------------------
# 14. Next.js Public Client Configuration [FRONTEND-SAFE]
# ------------------------------------------------------------------------------
# Safe public browser settings (NEVER put secret keys or service role tokens here!)
NEXT_PUBLIC_WORKER_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_REPLACE_WITH_SUPABASE_ANON_KEY

# ------------------------------------------------------------------------------
# 15. Optional Monitoring & Telemetry [SERVER-ONLY]
# ------------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
